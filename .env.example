# ---- Runtime -------------------------------------------------------------
FORGE_DOMAIN=                      # production only: public hostname served by Caddy (e.g. forge.example.com)
FORGE_ENV=development              # development | production | test
FORGE_PUBLIC_URL=http://localhost:3000
FORGE_CORS_ORIGINS=http://localhost:3000
FORGE_SESSION_SECRET=              # REQUIRED in production: 32+ random chars (openssl rand -hex 32)
FORGE_SESSION_TTL_HOURS=336

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://forge:forge_dev_password@localhost:5432/forge

# ---- Nebius Token Factory (REQUIRED) ----------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model ids must match `GET {NEBIUS_BASE_URL}models` for your account.
NEBIUS_MODEL_NANO=
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=
NEBIUS_MODEL_DEFAULT=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MAX_CONCURRENCY=4

# ---- Tavily (research tool; optional — tool reports "not configured" without it)
TAVILY_API_KEY=

# ---- GitHub (public repo import needs no credentials) ----------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Object storage (S3-compatible: MinIO locally, Nebius Object Storage in prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=forge-artifacts
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=forge_dev_access
STORAGE_SECRET_KEY=forge_dev_secret_key

# ---- Worker / sandbox --------------------------------------------------------
FORGE_WORKSPACES_ROOT=./data/workspaces
FORGE_WORKER_CONCURRENCY=4
FORGE_JOB_LEASE_SECONDS=60
FORGE_SANDBOX_IMAGE=python:3.12-slim
FORGE_SANDBOX_ENABLED=true
DOCKER_GID=999                     # production compose: gid of the docker group on the VM
FORGE_PRICING_FILE=                # optional path to a pricing.json (USD per 1M tokens per model)

# ---- Frontend (Next.js) ------------------------------------------------------
FORGE_API_URL=http://localhost:8000
